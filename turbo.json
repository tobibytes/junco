{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "out/**"
      ]
    },
    "@junco/tailwind#build": {
      "outputs": []
    },
    "//#registry:build": {
      "inputs": [
        "scripts/**",
        "packages/react/src/**",
        "packages/react/package.json",
        "packages/tokens/src/**",
        "packages/tailwind/src/**",
        "registry/**",
        "templates/**",
        "apps/docs/content/blocks/catalog.ts"
      ],
      "outputs": [
        "apps/docs/public/r/**",
        "apps/docs/public/schema/**",
        "apps/docs/public/llms.txt",
        "apps/docs/public/llms-full.txt"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@junco/cli#test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/packages/react/src/**",
        "$TURBO_ROOT$/packages/tokens/src/**",
        "$TURBO_ROOT$/packages/tailwind/src/**",
        "$TURBO_ROOT$/registry/**",
        "$TURBO_ROOT$/templates/**",
        "$TURBO_ROOT$/apps/docs/content/blocks/catalog.ts"
      ],
      "outputs": []
    },
    "@junco/mcp#test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/packages/react/src/**",
        "$TURBO_ROOT$/packages/tokens/src/**",
        "$TURBO_ROOT$/packages/tailwind/src/**",
        "$TURBO_ROOT$/registry/**",
        "$TURBO_ROOT$/templates/**",
        "$TURBO_ROOT$/apps/docs/content/blocks/catalog.ts"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "@junco/cli#typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/**"
      ]
    },
    "docs#build": {
      "dependsOn": [
        "^build",
        "//#registry:build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "out/**"
      ]
    },
    "mcp-worker#test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/packages/react/src/**",
        "$TURBO_ROOT$/packages/tokens/src/**",
        "$TURBO_ROOT$/packages/tailwind/src/**",
        "$TURBO_ROOT$/registry/**",
        "$TURBO_ROOT$/templates/**"
      ],
      "outputs": []
    }
  }
}
