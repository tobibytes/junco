{
  "name": "junco-monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "css:example": "tailwindcss -i examples/plain-html/input.css -o examples/plain-html/junco.css",
    "registry:build": "node scripts/build-registry.ts",
    "changeset": "changeset",
    "release": "turbo run build && changeset publish",
    "check:dist": "node scripts/check-dist.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@tailwindcss/cli": "4",
    "tailwindcss": "4",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
