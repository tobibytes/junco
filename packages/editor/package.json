{
  "name": "@junco/editor",
  "version": "0.0.0",
  "description": "Junco rich text editor on TipTap: toolbar, slash commands, markdown shortcuts, and real-time collaboration with shared cursors on any Yjs document (Towhee or others).",
  "license": "MIT",
  "author": "Oluwatobi Olajide",
  "homepage": "https://junco.madebytobi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobibytes/junco.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/tobibytes/junco/issues"
  },
  "keywords": [
    "editor",
    "rich-text",
    "tiptap",
    "prosemirror",
    "yjs",
    "collaboration",
    "react",
    "tailwindcss"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@junco/react": "workspace:*",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-collaboration": "^3.32.1",
    "@tiptap/extension-collaboration-caret": "^3.32.1",
    "@tiptap/extension-placeholder": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@tiptap/y-tiptap": "^3.0.11"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3",
    "yjs": "^13.6.33"
  },
  "publishConfig": {
    "access": "public"
  }
}
