{
  "name": "@junco/blocks",
  "version": "0.0.0",
  "description": "Junco blocks and full pages: app shells, dashboards, settings, auth, marketing. Typed props, fake data fallbacks, slots and variants.",
  "license": "MIT",
  "author": "Oluwatobi Olajide",
  "homepage": "https://junco.madebytobi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobibytes/junco.git",
    "directory": "packages/blocks"
  },
  "bugs": {
    "url": "https://github.com/tobibytes/junco/issues"
  },
  "keywords": [
    "react",
    "blocks",
    "templates",
    "dashboard",
    "landing-page",
    "saas",
    "pages"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    },
    "./marketing": {
      "types": "./dist/marketing/index.d.ts",
      "import": "./dist/marketing/index.js"
    },
    "./fake": {
      "types": "./dist/lib/fake.d.ts",
      "import": "./dist/lib/fake.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@tanstack/react-table": "^8.21.3",
    "@junco/motion": "workspace:*",
    "junco": "workspace:*",
    "react-hook-form": "^7.91.0",
    "tailwind-variants": "^1.0.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.10.0",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
