{
  "name": "@junco/blocks",
  "version": "0.0.0",
  "description": "Junco blocks and full pages: app shells, dashboards, settings, auth, marketing. Typed props, fake data fallbacks, slots and variants.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./app": { "types": "./dist/app/index.d.ts", "import": "./dist/app/index.js" },
    "./marketing": { "types": "./dist/marketing/index.d.ts", "import": "./dist/marketing/index.js" },
    "./fake": { "types": "./dist/lib/fake.d.ts", "import": "./dist/lib/fake.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "junco": "workspace:*",
    "tailwind-variants": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.10.0",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3"
  }
}
