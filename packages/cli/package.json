{
  "name": "@junco/cli",
  "version": "0.0.0",
  "description": "Junco CLI: copy components into your project and keep them updated (init, add, diff, update, list)",
  "license": "MIT",
  "type": "module",
  "bin": { "junco": "./dist/index.js" },
  "files": ["dist"],
  "engines": { "node": ">=18.17" },
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node18 --clean",
    "dev": "tsup src/index.ts --format esm --target node18 --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
